{
  "name": "certfolio",
  "version": "1.0.0",
  "description": "Fast, multi-user certificate portfolio on Cloudflare Workers, D1, R2, and Hono",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "start": "wrangler dev --port 8787",
    "test": "tsx --test tests/file-type.test.ts tests/validation.test.ts tests/rate-limit.test.ts tests/auth.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply certfolio-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply certfolio-db --remote",
    "db:seed": "wrangler d1 execute certfolio-db --local --file=./src/db/seed.sql"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "wrangler": "^3.111.0"
  }
}

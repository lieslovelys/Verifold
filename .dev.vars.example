# Session encryption secret (required in production, fallback used in dev)
AUTH_SECRET="change-this-to-a-very-secure-random-32-byte-string"

# Optional: Google OAuth credentials (if enabling Google login button)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public app URL (e.g., https://certfolio.pages.dev or http://localhost:8787)
APP_URL="http://localhost:8787"

# Environment
ENVIRONMENT="development"

